#!/bin/bash
#
# Make a Ventoy stick as a disk image, with the ISO on its exFAT partition,
# for test/integration.d/ventoy-test.sh. Ventoy boots the ISO as a file and
# injects its own initramfs scripts, a path neither an optical drive nor a
# dd'ed stick takes; 4.5.0rc2 hung behind the splash there.
#
# Ventoy2Disk.sh needs a block device, so this attaches the image to a loop
# device and mounts the data partition: it runs as root (through sudo when
# not root already), with GNU parted and dosfstools, which Ventoy2Disk.sh
# calls.

set -euo pipefail

VENTOY_VERSION=1.1.18
VENTOY_SHA256=d86ff9de63d94c8b8f1f6b14d23c55af4b88e8207bf2893890892a6a97b1ad54

if (($# != 2)); then
  echo "Usage: omarchy-iso-test-ventoy-disk <omarchy.iso> <ventoy.img>" >&2
  exit 1
fi
iso=$(realpath "$1")
out=$(realpath -m "$2")
[[ -f $iso ]] || { echo "No such ISO: $iso" >&2; exit 1; }

sudo=()
((EUID == 0)) || sudo=(sudo -n)

work=$(mktemp -d)
loop=""
cleanup() {
  [[ -d $work/mnt ]] && "${sudo[@]}" umount "$work/mnt" 2>/dev/null || true
  [[ -n $loop ]] && "${sudo[@]}" losetup -d "$loop" || true
  rm -rf "$work"
}
trap cleanup EXIT

tarball="$work/ventoy-$VENTOY_VERSION-linux.tar.gz"
curl -fsSL --retry 3 -o "$tarball" \
  "https://github.com/ventoy/Ventoy/releases/download/v$VENTOY_VERSION/ventoy-$VENTOY_VERSION-linux.tar.gz"
echo "$VENTOY_SHA256  $tarball" | sha256sum -c --quiet -
tar -xzf "$tarball" -C "$work"

# The ISO, 1 GiB for exFAT and Ventoy's own 32 MiB partition, sparse.
rm -f "$out"
truncate -s $(($(stat -c %s "$iso") + (1 << 30))) "$out"
loop=$("${sudo[@]}" losetup --show -f "$out")
# GPT (-g), as UEFI machines are set up; Ventoy asks twice before it writes.
(cd "$work/ventoy-$VENTOY_VERSION" && printf 'y\ny\n' | "${sudo[@]}" sh ./Ventoy2Disk.sh -I -g "$loop" >/dev/null)
"${sudo[@]}" losetup -d "$loop"
loop=$("${sudo[@]}" losetup --show -fP "$out")

mkdir "$work/mnt"
"${sudo[@]}" mount -o "uid=$(id -u)" "${loop}p1" "$work/mnt"
cp "$iso" "$work/mnt/"
# No second menu: Enter on the ISO boots it in normal mode, and r before it
# switches to GRUB2 mode, so a test drives Ventoy by keys alone.
mkdir -p "$work/mnt/ventoy"
echo '{ "control": [ { "VTOY_SECONDARY_BOOT_MENU": "0" } ] }' >"$work/mnt/ventoy/ventoy.json"
sync
echo "Ventoy $VENTOY_VERSION stick with ${iso##*/}: $out"
